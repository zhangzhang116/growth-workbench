.task-check { width: 18px; height: 18px; border: 2px solid var(--pink4); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 10px; color: rgb(255, 255, 255); flex-shrink: 0; transition: 0.2s; }

