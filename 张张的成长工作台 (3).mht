@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap");

:root { --pink1: #FFF8FA; --pink2: #FFE5EE; --pink3: #FFD0E0; --pink4: #FFB6C1; --pink5: #FF69B4; --pink6: #FF4080; --cream: #FFF9F5; --bg: #FEF6F9; --card: #FFFFFF; --text1: #5A3A4A; --text2: #8A6A7A; --shadow: 0 2px 12px rgba(255,105,180,0.08); --good: #4CAF50; --bad: #FF5252; --warn: #FFB74D; --green: #66BB6A; --water: #42A5F5; --tree: #81C784; --radius: 14px; --radius-sm: 10px; }

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: Nunito, "Microsoft YaHei", sans-serif; }

