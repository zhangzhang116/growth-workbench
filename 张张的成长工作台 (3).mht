@keyframes kittyBounce { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
}

@keyframes treeGrow { 
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.game-scene { position: relative; height: 180px; background: linear-gradient(rgb(232, 245, 233) 0%, rgb(200, 230, 201) 60%, rgb(165, 214, 167) 100%); border-radius: var(--radius); overflow: hidden; margin-bottom: 12px; border: 1px solid var(--pink2); }

.game-scene .sky { position: absolute; top: 10px; right: 20px; font-size: 20px; animation: 3s ease-in-out 0s infinite normal none running float; }

.game-scene .ground { position: absolute; bottom: 0px; left: 0px; right: 0px; height: 30px; background: linear-gradient(rgb(129, 199, 132), rgb(102, 187, 106)); }

.game-scene .kitty { position: absolute; bottom: 28px; left: 30%; font-size: 36px; transition: 0.5s; z-index: 5; }

.game-scene .tree { position: absolute; bottom: 28px; right: 25%; font-size: 0px; transition: 0.5s; z-index: 4; }

.game-scene .tree .trunk { font-size: 24px; position: absolute; bottom: 0px; left: 50%; transform: translateX(-50%); }

.game-scene .tree .leaves { font-size: 32px; position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); }

.game-scene .tree.grown .leaves { font-size: 48px; animation: 2s ease-in-out 0s infinite normal none running treeGrow; }

.game-scene .food-bowl { position: absolute; bottom: 28px; left: 55%; font-size: 24px; z-index: 3; }

.game-scene .zombie { position: absolute; bottom: 28px; left: -50px; font-size: 32px; transition: 1s; z-index: 6; }

.game-scene .zombie.show { left: 15%; }

.game-scene .zombie.eat { animation: 0.8s ease-in-out 0s 1 normal none running zombieEat; }

@keyframes zombieEat { 
  0% { transform: scale(1); }
  25% { transform: scale(1.2) rotate(-10deg); }
  50% { transform: scale(1.3) rotate(10deg); }
  75% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

@keyframes float { 
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-8px) rotate(5deg); }
}

.game-scene .cloud { position: absolute; top: 15px; font-size: 18px; opacity: 0.7; animation: 15s linear 0s infinite normal none running cloudMove; }

@keyframes cloudMove { 
  0% { left: -30px; }
  100% { left: 100%; }
}

.game-scene .rain { position: absolute; width: 2px; height: 8px; background: rgb(66, 165, 245); opacity: 0.6; animation: 0.8s linear 0s infinite normal none running rainDrop; }

@keyframes rainDrop { 
  0% { top: 0px; opacity: 1; }
  100% { top: 100px; opacity: 0; }
}

