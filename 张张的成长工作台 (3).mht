.brand .bow { font-size: 18px; display: inline-block; animation: 2.5s ease-in-out 0s infinite normal none running sway; }

@keyframes sway { 
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.nav-item { display: flex; align-items: center; padding: 8px 12px; margin: 3px 0px; border-radius: var(--radius-sm); cursor: pointer; transition: 0.25s; font-size: 12.5px; color: var(--text1); position: relative; gap: 8px; }

.nav-item:hover { background: var(--pink2); transform: translateX(3px); }

.nav-item.active { background: linear-gradient(90deg,var(--pink3),var(--pink2)); color: var(--pink6); font-weight: 700; box-shadow: var(--shadow); }

.nav-icon { width: 24px; height: 24px; border-radius: 50%; background: var(--pink2); display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }

.nav-item.active .nav-icon { background: var(--pink5); color: rgb(255, 255, 255); }

.nav-count { font-size: 10px; background: var(--pink5); color: rgb(255, 255, 255); padding: 1px 6px; border-radius: 10px; margin-left: auto; }

.nav-check { font-size: 10px; margin-left: auto; color: var(--good); }

.reset-btn { width: 100%; padding: 7px; border: 1px dashed var(--pink5); border-radius: 8px; background: linear-gradient(135deg,var(--pink1),var(--cream)); color: var(--pink6); font-size: 11px; font-weight: 700; cursor: pointer; transition: 0.2s; }

.reset-btn:hover { background: linear-gradient(135deg,var(--pink2),var(--pink3)); border-color: var(--pink6); transform: scale(1.02); }

.menu-btn { display: none; position: fixed; top: 12px; left: 12px; z-index: 100; width: 36px; height: 36px; border-radius: 50%; background: var(--card); border: 1px solid var(--pink3); font-size: 18px; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow); }

.overlay { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.15); z-index: 9; }

.main { flex: 1 1 0%; overflow-y: auto; padding: 10px 14px 90px; scroll-behavior: smooth; }

.main::-webkit-scrollbar { width: 5px; }

.main::-webkit-scrollbar-thumb { background: var(--pink3); border-radius: 3px; }

.me-footer { margin-top: 6px; padding-top: 14px; border-top: 2px solid var(--pink3); }

.bottom-nav { position: fixed; bottom: 0px; left: 0px; right: 0px; height: 56px; background: var(--card); border-top: 1px solid var(--pink2); display: flex; align-items: center; justify-content: space-around; z-index: 60; box-shadow: rgba(255, 105, 180, 0.08) 0px -2px 12px; padding-bottom: env(safe-area-inset-bottom,0); }

.bottom-nav .bn-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; cursor: pointer; padding: 4px 14px; border-radius: 12px; transition: 0.2s; font-size: 10px; color: var(--text2); min-width: 56px; position: relative; }

.bottom-nav .bn-item .bn-icon { font-size: 20px; line-height: 1; transition: transform 0.2s; }

.bottom-nav .bn-item.active { color: var(--pink6); font-weight: 700; }

.bottom-nav .bn-item.active .bn-icon { transform: scale(1.15); }

.bottom-nav .bn-item:active { transform: scale(0.95); }

.bottom-nav .bn-dot { position: absolute; top: 2px; right: 10px; width: 6px; height: 6px; border-radius: 50%; background: var(--pink5); }

.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed var(--pink3); }

.header h2 { font-size: 16px; color: var(--pink6); display: flex; align-items: center; gap: 6px; }

.header h2 .icon { font-size: 18px; }

.date-tag { background: var(--pink2); color: var(--pink6); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }

.card { background: var(--card); border-radius: var(--radius); padding: 10px; margin-bottom: 8px; box-shadow: var(--shadow); border: 1px solid var(--pink1); animation: 0.4s ease 0s 1 normal none running fadeUp; }

@keyframes fadeUp { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.card-title { font-size: 12px; font-weight: 700; color: var(--pink6); margin-bottom: 8px; display: flex; align-items: center; gap: 5px; }

.card-title .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pink5); }

.two { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

.task-item { display: flex; align-items: center; gap: 6px; padding: 5px 8px; background: var(--cream); border-radius: var(--radius-sm); margin: 3px 0px; font-size: 11px; transition: 0.2s; }

.task-item:hover { background: var(--pink1); transform: translateX(2px); }

