.modal-overlay { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.25); z-index: 200; display: none; align-items: center; justify-content: center; backdrop-filter: blur(2px); }

.modal-overlay.show { display: flex; }

.modal { background: var(--card); border-radius: var(--radius); padding: 20px; max-width: 340px; width: 90%; text-align: center; box-shadow: rgba(0, 0, 0, 0.15) 0px 8px 32px; animation: 0.3s ease 0s 1 normal none running popIn; border: 1px solid var(--pink2); }

@keyframes popIn { 
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.modal-title { font-size: 16px; font-weight: 800; color: var(--pink6); margin-bottom: 10px; }

.modal-text { font-size: 13px; color: var(--text2); margin-bottom: 14px; line-height: 1.6; }

.modal-icon { font-size: 48px; margin-bottom: 10px; animation: 0.6s ease 0s 1 normal none running shake; }

@keyframes shake { 
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

.modal-btns { display: flex; gap: 8px; justify-content: center; }

.modal-btns .btn { flex: 1 1 0%; }

.checkin-log { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; justify-content: center; }

.checkin-log .log-dot { width: 20px; height: 20px; border-radius: 50%; background: var(--pink1); display: flex; align-items: center; justify-content: center; font-size: 10px; border: 1px solid var(--pink2); }

.checkin-log .log-dot.done { background: var(--good); color: rgb(255, 255, 255); border-color: var(--good); }

.checkin-log .log-dot.miss { background: var(--bad); color: rgb(255, 255, 255); border-color: var(--bad); }

.goal-input { width: 60px; padding: 3px 6px; border: 1px solid var(--pink3); border-radius: 6px; font-size: 11px; text-align: center; outline: none; background: var(--cream); }

.weather-card { background: linear-gradient(135deg, rgb(255, 229, 180) 0%, rgb(255, 208, 224) 50%, rgb(255, 182, 193) 100%); border-radius: var(--radius); padding: 12px; margin-bottom: 8px; color: rgb(90, 58, 74); position: relative; overflow: hidden; animation: 0.4s ease 0s 1 normal none running fadeUp; }

.weather-card .w-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.weather-card .w-temp { font-size: 36px; font-weight: 800; line-height: 1; color: rgb(255, 64, 128); }

.weather-card .w-icon { font-size: 48px; line-height: 1; animation: 3s ease-in-out 0s infinite normal none running float; }

.weather-card .w-info { flex: 1 1 0%; }

.weather-card .w-city { font-size: 13px; font-weight: 700; color: rgb(90, 58, 74); margin-bottom: 2px; }

.weather-card .w-desc { font-size: 11px; color: rgb(138, 106, 122); }

.weather-card .w-details { display: flex; gap: 12px; margin-top: 8px; font-size: 10px; color: rgb(138, 106, 122); flex-wrap: wrap; padding-top: 8px; border-top: 1px dashed rgba(255, 255, 255, 0.6); }

.weather-card .w-details span { display: flex; align-items: center; gap: 3px; }

.weather-card .w-refresh { position: absolute; top: 8px; right: 8px; background: rgba(255, 255, 255, 0.4); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; width: 24px; height: 24px; cursor: pointer; font-size: 12px; display: flex; align-items: center; justify-content: center; color: rgb(255, 64, 128); }

.weather-card .w-refresh:hover { background: rgba(255, 255, 255, 0.7); }

.weather-loading { display: flex; align-items: center; gap: 8px; justify-content: center; padding: 6px; font-size: 11px; color: rgb(138, 106, 122); }

@media (max-width: 768px) {
  .sidebar { position: fixed; left: 0px; top: 0px; height: 100vh; transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0px); }
  .menu-btn { display: flex; }
  .overlay.show { display: block; }
  .main { padding: 12px 12px 90px; margin-left: 0px; }
  .two, .three { grid-template-columns: 1fr; }
  .week-grid { grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .week-day { padding: 5px 2px; font-size: 9px; }
  .closet-grid { grid-template-columns: repeat(3, 1fr); }
  .shop-grid { grid-template-columns: repeat(2, 1fr); }
  .savings-plans { grid-template-columns: 1fr; }
  .timer-display { font-size: 32px; }
  .weather-card .w-temp { font-size: 28px; }
  .weather-card .w-icon { font-size: 36px; }
  .bili-card .bili-thumb { width: 70px; height: 48px; }
}

@media (max-width: 480px) {
  .header h2 { font-size: 15px; }
  .card { padding: 10px; }
  .week-day .wk-num { font-size: 8px; }
  .asset-box { padding: 8px 12px; min-width: 70px; }
  .asset-box .asset-icon { font-size: 22px; }
  .asset-box .asset-num { font-size: 18px; }
  .path-line { padding-left: 30px; }
  .path-step::before { left: -26px; width: 20px; height: 20px; font-size: 10px; }
}

.empty { text-align: center; padding: 20px; color: var(--text2); font-size: 12px; }

.empty .icon { font-size: 32px; margin-bottom: 6px; opacity: 0.4; }

::-webkit-scrollbar { width: 4px; height: 4px; }

::-webkit-scrollbar-track { background: transparent; }

::-webkit-scrollbar-thumb { background: var(--pink3); border-radius: 2px; }

.fade { animation: 0.4s ease 0s 1 normal none running fadeUp; }

.pulse { animation: 1.5s ease-in-out 0s infinite normal none running pulse; }

@keyframes pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.modal-overlay { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.85); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px; }

.modal-overlay.show { display: flex; }

.modal-content { background: rgb(255, 255, 255); border-radius: 12px; max-width: 800px; width: 100%; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column; }

.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--pink1); }

.modal-header h3 { font-size: 14px; font-weight: 600; flex: 1 1 0%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.modal-close { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-size: 24px; cursor: pointer; color: var(--text2); padding: 0px 4px; line-height: 1; }

.modal-body { flex: 1 1 0%; overflow: auto; background: rgb(0, 0, 0); display: flex; align-items: center; justify-content: center; min-height: 400px; }

.modal-body video { max-width: 100%; max-height: 80vh; }

.modal-body iframe { width: 100%; height: 100%; min-height: 400px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }
